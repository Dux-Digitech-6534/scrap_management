{
 "doctype": "Print Format",
 "name": "Sales Order Print",
 "doc_type": "Sales Order",
 "module": "Scrap Management",
 "standard": "Yes",
 "custom_format": 1,
 "print_format_type": "Jinja",
 "disabled": 0,
 "align_labels_right": 0,
 "font": "Default",
 "html": "<div style=\"padding:16px;font-family:Geist,Arial,sans-serif;color:#1a2030;font-size:12px;\">\n  <div style=\"display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid #5c4de6;padding-bottom:10px;margin-bottom:14px;\">\n    <img src=\"/assets/scrap_management/images/dux-logo.png\" style=\"height:34px;\" />\n    <div style=\"text-align:right;\">\n      <div style=\"font-size:16px;font-weight:700;letter-spacing:-.01em;\">Sales Order</div>\n      <div style=\"font-size:11px;color:#586273;\">{{ doc.company or \"\" }}</div>\n    </div>\n  </div>\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:12px;\">\n    <tr>\n      <td style=\"width:33%;padding:3px 0;\"><b>Sales Order No:</b> {{ doc.name }}</td>\n      <td style=\"width:33%;padding:3px 0;\"><b>Order Date:</b> {{ frappe.utils.formatdate(doc.transaction_date) }}</td>\n      <td style=\"width:33%;padding:3px 0;\"><b>Status:</b> {{ doc.status }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:3px 0;\"><b>Customer:</b> {{ doc.customer_name or doc.customer }}</td>\n      <td style=\"padding:3px 0;\"><b>Delivery Date:</b> {{ frappe.utils.formatdate(doc.delivery_date) if doc.delivery_date else \"\" }}</td>\n      <td style=\"padding:3px 0;\"><b>Linked Scrap:</b> {{ doc.custom_scrap or \"—\" }}</td>\n    </tr>\n  </table>\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:12px;border:1px solid #e7e9ee;\">\n    <thead>\n      <tr style=\"background:#fafafc;\">\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">#</th>\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">Item</th>\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">Qty</th>\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">UOM</th>\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">Rate</th>\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">Amount</th>\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">Warehouse</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.items %}\n      <tr>\n        <td style=\"padding:7px 8px;border-bottom:1px solid #f0f1f4;\">{{ row.idx }}</td>\n        <td style=\"padding:7px 8px;border-bottom:1px solid #f0f1f4;\">{{ row.item_name or row.item_code }}</td>\n        <td style=\"padding:7px 8px;border-bottom:1px solid #f0f1f4;font-family:'JetBrains Mono',monospace;\">{{ row.qty }}</td>\n        <td style=\"padding:7px 8px;border-bottom:1px solid #f0f1f4;\">{{ row.uom }}</td>\n        <td style=\"padding:7px 8px;border-bottom:1px solid #f0f1f4;font-family:'JetBrains Mono',monospace;\">{{ frappe.format_value(row.rate, {\"fieldtype\": \"Currency\"}) }}</td>\n        <td style=\"padding:7px 8px;border-bottom:1px solid #f0f1f4;font-family:'JetBrains Mono',monospace;\">{{ frappe.format_value(row.amount, {\"fieldtype\": \"Currency\"}) }}</td>\n        <td style=\"padding:7px 8px;border-bottom:1px solid #f0f1f4;\">{{ row.warehouse or \"\" }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:12px;\">\n    <tr>\n      <td style=\"width:33%;padding:3px 0;\"><b>Grand Total:</b> {{ frappe.format_value(doc.grand_total, {\"fieldtype\": \"Currency\"}) }}</td>\n      <td style=\"width:33%;padding:3px 0;\"><b>Delivered %:</b> {{ doc.per_delivered or 0 }}</td>\n      <td style=\"width:33%;padding:3px 0;\"><b>Billed %:</b> {{ doc.per_billed or 0 }}</td>\n    </tr>\n  </table>\n  <table style=\"width:100%;margin-top:30px;\">\n    <tr>\n      <td style=\"width:50%;text-align:center;padding-top:30px;border-top:1px solid #1a2030;\">Prepared By</td>\n      <td style=\"width:50%;text-align:center;padding-top:30px;border-top:1px solid #1a2030;\">Approved By</td>\n    </tr>\n  </table>\n</div>"
}
