{
 "doctype": "Print Format",
 "name": "Scrap Gate Pass",
 "doc_type": "Delivery Note",
 "module": "Scrap Management",
 "standard": "Yes",
 "custom_format": 1,
 "print_format_type": "Jinja",
 "disabled": 0,
 "align_labels_right": 0,
 "font": "Default",
 "html": "<div style=\"padding:16px;font-family:Geist,Arial,sans-serif;color:#1a2030;\">\n  <div style=\"display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid #5c4de6;padding-bottom:10px;margin-bottom:14px;\">\n    <img src=\"/assets/scrap_management/images/dux-logo.png\" style=\"height:34px;\" />\n    <div style=\"text-align:right;\">\n      <div style=\"font-size:16px;font-weight:700;letter-spacing:-.01em;\">Scrap Gate Pass</div>\n      <div style=\"font-size:11px;color:#586273;\">{{ doc.company }}</div>\n    </div>\n  </div>\n  <table style=\"width:100%;font-size:12px;border-collapse:collapse;margin-bottom:12px;\">\n    <tr>\n      <td style=\"width:50%;padding:3px 0;\"><b>Gate Pass No:</b> {{ doc.custom_gate_pass_no or \"\" }}</td>\n      <td style=\"width:50%;padding:3px 0;\"><b>Delivery Note:</b> {{ doc.name }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:3px 0;\"><b>Scrap Reference:</b> {{ doc.custom_scrap or \"\" }}</td>\n      <td style=\"padding:3px 0;\"><b>Date:</b> {{ frappe.utils.formatdate(doc.posting_date) }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding:3px 0;\"><b>Customer:</b> {{ doc.customer_name or doc.customer }}</td>\n      <td style=\"padding:3px 0;\"><b>Sales Order:</b> {{ doc.items[0].against_sales_order if doc.items else \"\" }}</td>\n    </tr>\n  </table>\n  <table style=\"width:100%;font-size:12px;border-collapse:collapse;margin-bottom:12px;border:1px solid #e7e9ee;border-radius:8px;\">\n    <tr style=\"background:#fafafc;\"><td colspan=\"2\" style=\"padding:7px 8px;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;\">Vehicle &amp; Driver Details</td></tr>\n    <tr><td style=\"padding:7px 8px;width:50%;\"><b>Vehicle Number:</b> {{ doc.custom_vehicle_number or \"\" }}</td><td style=\"padding:7px 8px;\"><b>Driver Name:</b> {{ doc.custom_driver_name or \"\" }}</td></tr>\n    <tr><td style=\"padding:7px 8px;\"><b>Driver Mobile:</b> {{ doc.custom_driver_mobile or \"\" }}</td><td style=\"padding:7px 8px;\"><b>Driver ID / Reference:</b> {{ doc.custom_driver_id or \"\" }}</td></tr>\n  </table>\n  <table style=\"width:100%;font-size:12px;border-collapse:collapse;margin-bottom:12px;border:1px solid #e7e9ee;\">\n    <thead>\n      <tr style=\"background:#fafafc;\">\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">Item</th>\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">Qty</th>\n        <th style=\"padding:7px 8px;text-align:left;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;border-bottom:1px solid #e7e9ee;\">UOM</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for row in doc.items %}\n      <tr>\n        <td style=\"padding:7px 8px;\">{{ row.item_name or row.item_code }}</td>\n        <td style=\"padding:7px 8px;font-family:'JetBrains Mono',monospace;\">{{ row.qty }}</td>\n        <td style=\"padding:7px 8px;\">{{ row.uom }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  <table style=\"width:100%;font-size:12px;border-collapse:collapse;margin-bottom:20px;border:1px solid #e7e9ee;\">\n    <tr style=\"background:#fafafc;\"><td colspan=\"2\" style=\"padding:7px 8px;color:#586273;text-transform:uppercase;font-size:10px;letter-spacing:.06em;\">Handover &amp; Security Exit</td></tr>\n    <tr>\n      <td style=\"padding:7px 8px;width:50%;\"><b>Handover Confirmed:</b> <span style=\"padding:2px 8px;border-radius:999px;font-size:11px;{{ 'background:rgba(21,145,106,.1);color:#15916a;' if doc.custom_handover_confirmed else 'background:#fafafc;color:#8a93a3;' }}\">{{ \"Yes\" if doc.custom_handover_confirmed else \"No\" }}</span>{% if doc.custom_handover_datetime %} on {{ doc.custom_handover_datetime }}{% endif %}</td>\n      <td style=\"padding:7px 8px;\"><b>Security Exit Confirmed:</b> <span style=\"padding:2px 8px;border-radius:999px;font-size:11px;{{ 'background:rgba(21,145,106,.1);color:#15916a;' if doc.custom_security_exit_confirmed else 'background:#fafafc;color:#8a93a3;' }}\">{{ \"Yes\" if doc.custom_security_exit_confirmed else \"No\" }}</span>{% if doc.custom_security_exit_datetime %} on {{ doc.custom_security_exit_datetime }}{% endif %}</td>\n    </tr>\n    <tr>\n      <td colspan=\"2\" style=\"padding:7px 8px;\"><b>Security Remarks:</b> {{ doc.custom_security_remarks or \"\" }}</td>\n    </tr>\n  </table>\n  <table style=\"width:100%;font-size:12px;margin-top:30px;\">\n    <tr>\n      <td style=\"width:33%;text-align:center;padding-top:30px;border-top:1px solid #1a2030;\">Store Person</td>\n      <td style=\"width:33%;text-align:center;padding-top:30px;border-top:1px solid #1a2030;\">Driver Signature</td>\n      <td style=\"width:33%;text-align:center;padding-top:30px;border-top:1px solid #1a2030;\">Security Signature</td>\n    </tr>\n  </table>\n</div>"
}
